# Copy this file to .env and fill in the two tokens.
# .env is never committed.

# Bot token: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server's ID. Makes slash commands show up right away when you add or
# change one; without it the sync is global and Discord takes up to an hour.
# To get the ID: Settings > Advanced > Developer Mode, then right-click the
# server > Copy Server ID.
GUILD_ID=

# Needed to download the Pocket TTS weights.
# Accept the terms at https://huggingface.co/kyutai/pocket-tts and create a
# token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Language model: english, portuguese_24l, spanish_24l, french_24l,
# german_24l, italian_24l... (see the README). "_24l" = higher quality, slower.
# Voices are tied to the model they were cloned with: clone again after changing it.
TTS_LANGUAGE=english

VOICES_DIR=./voices

# Maximum characters per utterance.
MAX_TEXT_LEN=400

# Seconds of audio buffered before playback starts. Raise it if you hear cuts.
PREBUFFER_SECONDS=0.8

# Seconds with nothing in the queue before the bot leaves the channel on its own.
IDLE_TIMEOUT=300

# Seconds until the bot deletes its own public messages (/say and /status),
# so the text channel doesn't fill up. 0 turns it off. Ephemeral messages
# aren't affected: only the person who ran the command sees them.
AUTO_DELETE_SECONDS=0

# Where to write the usage history (who asked, text and voice).
# Query it with `python history.py summary`.
HISTORY_FILE=./logs/history.jsonl
